:root {
  --bg: #f6f9f8;
  --card: #ffffff;
  --primary: #2a9d8f;
  --primary-dark: #1f7a6f;
  --text: #264653;
  --muted: #6b8a8a;
  --border: #e3ecea;
  --accent: #e9c46a;
  --danger: #e76f51;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

.container { max-width: 960px; margin: 0 auto; padding: 24px 16px 60px; }

/* Header */
header {
  background: var(--card);
  border-bottom: 1px solid var(--border);
  margin-bottom: 28px;
}
.header-inner {
  max-width: 960px; margin: 0 auto; padding: 14px 16px;
  display: flex; align-items: center; justify-content: space-between;
}
.logo { font-size: 18px; font-weight: 700; color: var(--primary); }
nav { display: flex; gap: 6px; flex-wrap: wrap; }
nav button {
  border: none; background: none; padding: 8px 12px; border-radius: 8px;
  font-size: 15px; cursor: pointer; color: var(--muted);
}
nav button:hover { background: #eef5f4; color: var(--primary); }
nav button.active { background: var(--primary); color: #fff; }

/* Cards */
.card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 14px; padding: 20px; margin-bottom: 16px;
}
.card h2 { font-size: 18px; margin-bottom: 6px; }
.card .desc { color: var(--muted); font-size: 14px; margin-bottom: 12px; }

.grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px;
}

.btn {
  display: inline-block; border: none; cursor: pointer; border-radius: 10px;
  padding: 10px 20px; font-size: 15px; background: var(--primary); color: #fff;
}
.btn:hover { background: var(--primary-dark); }
.btn.secondary { background: #eef5f4; color: var(--primary); }
.btn:disabled { opacity: .5; cursor: not-allowed; }

/* Home */
.hero { text-align: center; padding: 40px 16px 30px; }
.hero h1 { font-size: 28px; margin-bottom: 10px; }
.hero p { color: var(--muted); margin-bottom: 22px; }
.steps { text-align: left; }

/* Letters */
.letter-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; }
.letter-card {
  background: var(--card); border: 1px solid var(--border); border-radius: 12px;
  padding: 12px 8px; text-align: center; cursor: pointer;
}
.letter-card:hover { border-color: var(--primary); }
.letter-card .big { font-size: 30px; font-weight: 700; color: var(--primary); }
.letter-card .sound { font-size: 12px; color: var(--muted); }

/* Words / Dialogues */
.word-list { display: flex; flex-direction: column; gap: 10px; }
.word-item {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px;
}
.word-item .en { font-size: 18px; font-weight: 600; }
.word-item .ph { color: var(--muted); font-size: 13px; margin-left: 8px; }
.word-item .zh { color: var(--muted); }
.speak-btn {
  border: none; background: #eef5f4; color: var(--primary); border-radius: 50%;
  width: 36px; height: 36px; font-size: 16px; cursor: pointer; flex-shrink: 0;
}
.speak-btn:hover { background: var(--primary); color: #fff; }

.sentence {
  padding: 12px 16px; border-radius: 12px; margin-bottom: 10px;
  background: var(--card); border: 1px solid var(--border);
}
.sentence .who { font-size: 12px; color: var(--muted); margin-bottom: 2px; }
.sentence .en { font-size: 16px; margin-bottom: 2px; }
.sentence .zh { font-size: 13px; color: var(--muted); }
.sentence.right { text-align: right; }

/* Quiz */
.progress-bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; margin: 10px 0 20px; }
.progress-bar > div { height: 100%; background: var(--primary); transition: width .3s; }
.quiz-option {
  display: block; width: 100%; text-align: left; padding: 14px 18px; margin-bottom: 10px;
  border: 1px solid var(--border); border-radius: 12px; background: var(--card);
  font-size: 16px; cursor: pointer;
}
.quiz-option:hover { border-color: var(--primary); }
.quiz-option.correct { border-color: var(--primary); background: #e8f5f2; }
.quiz-option.wrong { border-color: var(--danger); background: #fdeee9; }
.quiz-option:disabled { cursor: default; }
.feedback { min-height: 26px; margin: 8px 0; font-size: 15px; }
.feedback.ok { color: var(--primary); }
.feedback.no { color: var(--danger); }
.score-big { font-size: 40px; font-weight: 700; color: var(--primary); text-align: center; }

.pill {
  display: inline-block; padding: 2px 10px; border-radius: 999px;
  background: #eef5f4; color: var(--primary); font-size: 13px; margin-left: 8px;
}
.center { text-align: center; }
.mt { margin-top: 16px; }
.mt-s { margin-top: 8px; }
.mb { margin-bottom: 14px; }
.mb-s { margin-bottom: 8px; }
.ml { margin-left: 10px; }
.muted { color: var(--muted); font-size: 14px; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.center-row { justify-content: center; }
.pill.warn { background: #fdf3dc; color: #a37a12; }
a { color: var(--primary); }
.badge {
  display: inline-block; min-width: 18px; padding: 0 5px; margin-left: 4px; border-radius: 9px;
  background: var(--danger); color: #fff; font-size: 11px; line-height: 18px;
}

/* Plan */
.stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; }
.stat { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 14px; text-align: center; }
.stat .n { font-size: 24px; font-weight: 700; color: var(--primary); }
.stat .l { font-size: 13px; color: var(--muted); }
.today-tasks { display: flex; flex-direction: column; gap: 10px; }
.task { display: flex; justify-content: space-between; align-items: center; gap: 10px;
  border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; }
.task .desc { margin-bottom: 0; }
.week-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.week { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; }
.week-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.week .desc { font-size: 13px; margin-bottom: 8px; }
.day-chips { display: flex; gap: 6px; }
.day-chip {
  flex: 1; border: 1px solid var(--border); background: #fff; border-radius: 8px; padding: 4px 0;
  cursor: pointer; font-size: 14px; color: var(--text); display: flex; flex-direction: column; align-items: center;
}
.day-chip small { font-size: 10px; color: var(--muted); }
.day-chip:hover:not(:disabled) { border-color: var(--primary); }
.day-chip.done { background: #e8f5f2; color: var(--primary); border-color: #bfe3dc; }
.day-chip.current { background: var(--primary); color: #fff; border-color: var(--primary); }
.day-chip.current small { color: #dff; }
.day-chip.locked { opacity: .45; cursor: not-allowed; }

/* Lesson */
.lesson-head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
.lesson-title { font-size: 20px; font-weight: 700; }
.steps-line { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
.stepper { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0 14px; }
.stepper span { font-size: 13px; padding: 3px 10px; border-radius: 999px; background: #f0f4f3; color: var(--muted); }
.stepper span.on { background: var(--primary); color: #fff; }
.stepper span.past { background: #e8f5f2; color: var(--primary); }
.drill-head { display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); }
.flashcard { text-align: center; padding: 26px 10px; border: 1px solid var(--border); border-radius: 14px; }
.fc-en { font-size: 34px; font-weight: 700; }
.fc-ph { color: var(--muted); }
.fc-zh { font-size: 20px; margin: 8px 0 14px; }
.fc-ex { font-size: 16px; cursor: pointer; }
.fc-exzh { color: var(--muted); font-size: 14px; margin-bottom: 12px; }
.speak-check { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; margin-top: 8px; font-size: 14px; }
.speak-check.col { flex-direction: column; }
.speak-check .ok, .feedback-box.ok { color: var(--primary); }
.speak-check .no, .feedback-box.no { color: var(--danger); }
.ex-prompt { font-size: 20px; font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; }
.ex-sub { color: var(--muted); font-size: 14px; margin-bottom: 14px; }
.text-input {
  flex: 1; min-width: 200px; font-size: 17px; padding: 10px 14px;
  border: 1px solid var(--border); border-radius: 10px; outline: none;
}
.text-input:focus { border-color: var(--primary); }
.token-line { min-height: 52px; border-bottom: 2px dashed var(--border); padding: 8px 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.token-pool { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.token { border: 1px solid var(--border); background: #fff; border-radius: 8px; padding: 6px 12px; font-size: 16px; cursor: pointer; }
.token:disabled { opacity: .35; cursor: default; }
.token-line .token { background: #eef5f4; border-color: #cfe5e1; opacity: 1; }
.feedback-box { margin-top: 14px; padding: 12px 16px; border-radius: 12px; background: #f6f9f8; font-size: 15px; }
.feedback-box .explain { color: var(--text); margin-top: 4px; font-size: 14px; }
.grammar-points { margin: 10px 0 10px 20px; }
.grammar-points li { margin-bottom: 6px; }
.sub-title { font-size: 15px; margin: 16px 0 8px; }
.sentence.current { border-color: var(--primary); }
.hidden-en { color: var(--muted); font-style: italic; cursor: pointer; background: #f0f4f3; border-radius: 6px; padding: 2px 8px; display: inline-block; }
.en-s { font-weight: 600; }
.wrong-list { text-align: left; margin-top: 16px; }
.wrong-item { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 14px; }

/* Review */
.box-bars { display: flex; gap: 14px; align-items: flex-end; justify-content: center; height: 170px; padding-top: 10px; }
.box-bar { display: flex; flex-direction: column; align-items: center; width: 44px; }
.box-bar .bar { width: 100%; background: var(--primary); border-radius: 6px 6px 0 0; }
.box-bar .n { font-weight: 600; }
.box-bar .l { font-size: 12px; color: var(--muted); }

/* Voice settings */
.voice-settings { position: relative; }
.voice-toggle { border: 1px solid var(--border); background: #fff; border-radius: 8px; padding: 6px 10px; cursor: pointer; color: var(--primary); font-size: 14px; }
.voice-panel {
  position: absolute; right: 0; top: 40px; z-index: 10; width: 340px;
  background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,.08); font-size: 14px;
}
.vs-row { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
.vs-row label { display: flex; gap: 6px; align-items: center; cursor: pointer; }
.vs-row select { padding: 6px; border: 1px solid var(--border); border-radius: 8px; }

/* Stages */
.stat-row.five { grid-template-columns: repeat(5, 1fr); }
.goal-select { margin-left: 6px; padding: 4px 6px; border: 1px solid var(--border); border-radius: 8px; }
.progress-bar.thin { height: 5px; margin: 6px 0 0; }
.stage { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }
.stage.locked { opacity: .6; }
.stage-head { display: flex; justify-content: space-between; align-items: flex-start; cursor: pointer; gap: 10px; }
.stage-head .desc { margin: 2px 0 0; font-size: 13px; }
.stage-bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 10px; }
.mini-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
.stage-items { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 8px; }
.item-row {
  display: flex; justify-content: space-between; width: 100%; text-align: left; gap: 8px;
  border: none; border-bottom: 1px solid var(--border); background: none; padding: 7px 2px; font-size: 14px; cursor: pointer; color: var(--text);
}
.item-row:hover:not(:disabled) { color: var(--primary); }
.item-row.done { color: var(--primary); }
.item-row:disabled { color: var(--muted); cursor: not-allowed; }
.fc-def { font-size: 13px; color: var(--muted); margin: -6px 0 12px; }
.credits { font-size: 12px; margin-top: 10px; }
.login { max-width: 420px; }
.login-form { display: flex; flex-direction: column; gap: 10px; }
.login-form .text-input { flex: none; width: 100%; min-width: 0; }
.login-form .feedback { margin: 0; min-height: 0; }
.login-form .row { margin-top: 6px; }
.nowrap { white-space: nowrap; }
.stat-row.eight { grid-template-columns: repeat(4, 1fr); }
.stage-bars.six { grid-template-columns: repeat(6, 1fr); gap: 10px; }
.stage-items { grid-template-columns: repeat(2, 1fr); }
.passage { line-height: 1.9; font-size: 16px; margin: 10px 0; }
.p-line { cursor: pointer; }
.p-line:hover { background: #eef5f4; }
.p-zh { display: block; color: var(--muted); font-size: 13px; margin-bottom: 6px; }
.text-area { width: 100%; font-size: 16px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; font-family: inherit; resize: vertical; }
.text-area:focus { outline: none; border-color: var(--primary); }
.hint-box { background: #fdf8e7; border-radius: 10px; padding: 8px 12px; margin-bottom: 10px; font-size: 14px; }
.key { display: inline-block; margin: 0 8px 0 4px; }
.key.hit { color: var(--primary); }
.pron-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
.pron-card { border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; }
.pron-card .ipa { font-size: 22px; font-weight: 700; color: var(--primary); }
.pron-card .ws { margin: 2px 0 4px; }
.pron-card .ws button { border: none; background: #eef5f4; color: var(--primary); border-radius: 6px; padding: 2px 8px; margin: 0 4px 4px 0; cursor: pointer; }
.pron-card .tip { font-size: 13px; color: var(--muted); }
@media (max-width: 640px) {
  .stat-row.eight { grid-template-columns: repeat(2, 1fr); }
  .stage-bars.six { grid-template-columns: repeat(3, 1fr); }
  .stage-items { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .stat-row.five { grid-template-columns: repeat(2, 1fr); }
  .stage-items { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .stat-row { grid-template-columns: repeat(2, 1fr); }
  .header-inner { flex-direction: column; gap: 8px; }
}

/* 小屏幕适配 */
.task > div:first-child { min-width: 0; }
.task .btn, .lesson-head .btn { flex-shrink: 0; white-space: nowrap; }
@media (max-width: 640px) {
  .container { padding: 16px 12px 48px; }
  header { margin-bottom: 16px; }
  .header-inner { padding: 10px 12px; align-items: stretch; }
  .logo { font-size: 16px; text-align: center; }
  /* 导航一行排下，放不下就左右滑 */
  nav { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; justify-content: space-between; }
  nav::-webkit-scrollbar { display: none; }
  nav button { flex-shrink: 0; padding: 6px 10px; font-size: 14px; }
  .header-tools { justify-content: center; }
  .voice-settings { position: static; }
  .voice-panel { position: fixed; left: 12px; right: 12px; top: 12px; z-index: 30; width: auto; max-height: calc(100vh - 24px); overflow-y: auto; }
  .card { padding: 16px 14px; }
  .hero { padding: 20px 4px 16px; }
  .hero h1 { font-size: 22px; }
  .hero h1 .sep { display: block; height: 0; overflow: hidden; }
  .lesson-head { flex-direction: column; align-items: flex-start; gap: 8px; }
  .lesson-head .btn { padding: 6px 14px; font-size: 14px; }
  .lesson-title { font-size: 18px; }
  .task { padding: 10px 12px; }
  .task .btn { padding: 8px 12px; font-size: 14px; }
  .text-input { min-width: 0; }
  .fc-en { font-size: 28px; }
  .ex-prompt { font-size: 18px; flex-wrap: wrap; }
  .voice-panel .row .btn { flex: 1; }
}
@media (max-width: 360px) {
  nav { gap: 2px; }
  nav button { padding: 6px 7px; font-size: 13px; }
}
